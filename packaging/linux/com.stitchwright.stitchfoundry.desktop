[Desktop Entry]
Type=Application
Name=StitchFoundry
GenericName=Embroidery Digitizer
Comment=Digitize machine embroidery designs: DST, PES, JEF, VP3 and more
Exec=stitchfoundry %F
TryExec=stitchfoundry
Icon=com.stitchwright.stitchfoundry
Terminal=false
StartupNotify=true
StartupWMClass=com.stitchwright.stitchfoundry
Categories=Graphics;2DGraphics;VectorGraphics;
Keywords=embroidery;digitizing;stitch;dst;pes;jef;vp3;vector;svg;
# MimeType lists the formats File › Open reads that Info.plist.in declares for macOS. The type of .ai
# files is shared-mime-info's application/illustrator (brand-ok).
MimeType=image/svg+xml;application/pdf;application/x-stitchfoundry;application/x-vectorcraft;image/svg+xml-compressed;application/illustrator;application/x-ai-template;image/png;image/jpeg;image/gif;image/webp;image/tiff;image/bmp;application/x-vectorcraft-template;image/vnd.dxf;image/emf;image/wmf;image/x-eps;application/x-affinity;application/x-embroidery-dst;application/x-embroidery-exp;application/x-embroidery-jef;application/x-embroidery-pes;application/x-embroidery-pec;application/x-embroidery-vp3;application/x-embroidery-xxx;application/x-embroidery-u01;application/x-embroidery-pcs;application/x-embroidery-tap;application/x-embroidery-dsb;application/x-embroidery-dsz;application/x-embroidery-hus;
